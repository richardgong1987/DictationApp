<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the iOS app's Info.plist by the Tauri CLI. -->
<plist version="1.0">
<dict>
	<!-- Show the app's Documents folder, where lesson exports go, in the Files app
	     as On My iPhone › DictationApp. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The clock and battery take the app's appearance: dark on Sepia, light on Night
	     (src-tauri/src/appearance.rs). A fixed light style vanishes against Sepia. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
</dict>
</plist>
